# Local API port.
PORT=5000
# Use production in the deployed service.
NODE_ENV=development
# Replace the placeholder credentials with a least-privilege MongoDB user.
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/civicfix?retryWrites=true&w=majority
# Exact frontend origin; separate multiple allowed origins with commas.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional first-run administrator; set both values to create the admin account once.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
